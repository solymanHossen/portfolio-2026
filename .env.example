# Base URL used for canonical links, sitemap.xml, robots.txt, Open Graph and
# JSON-LD. Falls back to http://localhost:3000 in development if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Resend API key for the contact form (https://resend.com). Optional — if
# unset, the contact form still works but tells the visitor that live email
# delivery isn't configured yet instead of silently failing.
RESEND_API_KEY=

# Inbox address the contact form should deliver to. Required alongside
# RESEND_API_KEY for email delivery to actually be enabled.
CONTACT_TO_EMAIL=
